 * configure_file() writes it here.
 */
#ifndef ISF15ACP4_VERSION_H
#define ISF15ACP4_VERSION_H

/** Major version: incompatible API changes. */
#define ISF15ACP4_VERSION_MAJOR @ISF15ACP4_VERSION_MAJOR@
/** Minor version: features added compatibly. */
#define ISF15ACP4_VERSION_MINOR @ISF15ACP4_VERSION_MINOR@
/** Patch version: fixes. */
#define ISF15ACP4_VERSION_PATCH @ISF15ACP4_VERSION_PATCH@
/** Full version string, for example "0.1.0". */
#define ISF15ACP4_VERSION_STRING "@ISF15ACP4_VERSION@"

#endif // ISF15ACP4_VERSION_H
